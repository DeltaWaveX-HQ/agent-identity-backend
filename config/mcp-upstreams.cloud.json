{
  "listen": ":8080",
  "egress_allowlist": ["webhook.site", "example.com", "api.github.com", "raw.githubusercontent.com", "docs.anthropic.com"],
  "upstreams": [
    {
      "name": "bank",
      "description": "Demo core-banking API (stateful: balances and payments persist in Cloud SQL)",
      "transport": "stdio",
      "command": "/app/demo-bank-mcp",
      "env": { "BANK_DATABASE_URL": "${DATABASE_URL}" },
      "tools": {
        "initiate_payment": { "action": "payment_transfer", "amount_arg": "amount_inr" },
        "export_statement": { "action": "export", "url_args": ["destination_url"] },
        "delete_payee": { "action": "delete" }
      }
    },
    {
      "name": "files",
      "description": "Finance shared drive (official MCP filesystem server)",
      "transport": "stdio",
      "command": "mcp-server-filesystem",
      "args": ["/app/demo-data/finance"]
    },
    {
      "name": "web",
      "description": "Internet fetch (official MCP fetch server); its output is untrusted",
      "transport": "stdio",
      "command": "mcp-server-fetch",
      "untrusted_output": true,
      "tools": { "fetch": { "action": "read", "url_args": ["url"] } }
    },
    {
      "name": "github",
      "enabled_if_env": "GITHUB_TOKEN",
      "description": "GitHub's official remote MCP server (on when GITHUB_TOKEN is set)",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" }
    }
  ]
}
