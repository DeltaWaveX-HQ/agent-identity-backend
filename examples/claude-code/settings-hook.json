{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__agent-gw__.*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST http://localhost:8090/gateway/attribution -H 'Content-Type: application/json' --data-binary @- >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
